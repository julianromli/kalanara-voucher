+function deriveLegacyCategory(categoryName?: string): "MASSAGE" | "FACIAL" | "BODY_TREATMENT" | "PACKAGE" {
+  if (!categoryName) return "MASSAGE";
+  const upper = categoryName.toUpperCase();
+  if (upper.includes("FACIAL")) return "FACIAL";
+  if (upper.includes("BODY") || upper.includes("LULUR") || upper.includes("TREATMENT")) return "BODY_TREATMENT";
+  if (upper.includes("PACKAGE") || upper.includes("PAKET")) return "PACKAGE";
+  return "MASSAGE";
+}
